{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redaction Proof",
  "version": "0.1.3",
  "identifier": "in.sociobot.pdf-redaction-proof",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "Redaction Proof",
      "width": 1120,
      "height": 820,
      "minWidth": 390,
      "minHeight": 640,
      "dragDropEnabled": true,
      "backgroundColor": "#F4F1E8"
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://api.sociobot.in https://pilot-api.sociobot.in; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Prove what a redacted PDF still contains",
    "longDescription": "A local-first PDF structure auditor and sanitizer for redacted documents.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
